# Contraseña única del dueño. En producción, larga y aleatoria.
OWNER_PASSWORD=cambia-esto

# Secreto para firmar la cookie de sesión (HMAC).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Upstash Redis (integración de Vercel)
# Pega los valores sin comillas. La app tolera comillas accidentales, pero Vercel
# guarda el valor tal cual y es mejor mantenerlo limpio.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sembrar datos de demostración al primer arranque
SEED_DEMO=true
